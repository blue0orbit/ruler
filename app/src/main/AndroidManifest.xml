<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        No CAMERA (DECISIONS.md). INTERNET, ACCESS_NETWORK_STATE and AD_ID arrive from the ads SDK
        (owner decision 2026-10-20) and BILLING from Play Billing; none is declared here. One permission
        is added in M9:
        VIBRATE, for the tick-crossing haptic feedback. Written reason: a physical tick cannot be
        produced without the vibrator, it is a normal permission (never prompted to the user), it is
        optional in settings, and it collects nothing. Recorded in PROGRESS.md and in
        docs/permissions-audit.md (M11).
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".RulerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ruler"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AdMob app id from the admobAppId Gradle property (Google's test id until the owner sets
             the real one). Without this entry the ads SDK stops the app at start-up. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <!-- Google's measurement inside the ads SDK waits until the app starts the SDK, which only
             happens for free users after consent (core/ads/Ads.kt). A Pro user's app never starts it. -->
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true" />

        <!-- M6: CSV share. Not exported; the receiver gets a one-time read grant, so no
             storage permission is needed. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
