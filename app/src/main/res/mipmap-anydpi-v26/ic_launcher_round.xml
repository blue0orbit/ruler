<?xml version="1.0" encoding="utf-8"?>
<!--
    Round variant (DESIGN.md §11): identical to `ic_launcher`. A round launcher mask crops to the
    66 dp safe zone, which is where every drawn point of the plate already sits, so the same artwork
    serves both shapes and the two files cannot drift apart.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
