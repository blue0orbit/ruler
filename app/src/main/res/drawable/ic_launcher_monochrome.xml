    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:name="plate"
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="12">

        <path
            android:pathData="M25,40 L83,40 L83,68 L25,68 Z"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2"
            android:strokeLineJoin="miter" />

        <path
            android:pathData="M40,66 L40,60"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.4" />
        <path
            android:pathData="M50,66 L50,57"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.8" />
        <path
            android:pathData="M60,66 L60,54"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2.2" />
        <path
            android:pathData="M70,66 L70,51"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2.6" />

        <path
            android:pathData="M32,66 L32,44"
