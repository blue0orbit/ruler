<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The window theme only matters for the frames before Compose draws: the cold-start preview and the
        moment the settings are being read. Its background is the light palette's own background
        (ColorSafePalette.LIGHT, #F7F8FA), so the first frame is the app's colour rather than the
        platform's white. values-night/themes.xml swaps in the dark palette's background.
    -->
    <style name="Theme.Ruler" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFF7F8FA</item>
        <item name="android:colorBackground">#FFF7F8FA</item>
    </style>
</resources>
