    <!-- M11V (DESIGN.md §6): the bar drives four destinations, and Extend / level / protractor are
         reached from Tools. -->
    <string name="nav_ruler">Ruler</string>
    <string name="nav_tools">Tools</string>

    <!-- M21 (roadmap rule 9): the first free tool joins the Pro ones here, so the sentence names both
         halves — what costs money and what does not — rather than describing the page as all-Pro. -->
    <string name="tools_body">Four tools. Ring size is free for everyone. Extend, bubble level and protractor are part of Pro; the ruler, units, calibration, log and export stay free.</string>
    <string name="tools_ring_body">Measure the inside of a ring, or your finger with a strip of paper.</string>
    <string name="tools_extend_body">Measure something longer than your screen, piece by piece.</string>
    <string name="tools_level_body">Check whether a surface is flat, and which way it tips.</string>
    <string name="tools_protractor_body">Measure the angle between two edges.</string>

    <!-- DESIGN.md §9: an empty state says what ends it. -->
    <string name="log_empty_state_body">Measure something on the Ruler screen, then tap Save this measurement.</string>
