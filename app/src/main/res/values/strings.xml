    <string name="settings_inset_hint">How far the drawn edge of the ruler is from the edge of your phone. Measurements start at the start line, so an object lined up with the phone edge is short by this amount.</string>
    <string name="start_edge_format">Start line: %1$s mm from the phone edge</string>
    <string name="start_edge_label">start %1$s</string>
    <!-- Rule 14: a start line beyond the end of the screen leaves nothing to measure. Saying so is the
         only way out that does not leave the user staring at a 0 reading or a greyed-out button. -->
    <string name="start_edge_off_screen">The start line is past the end of this screen, so there is nothing to measure. In Settings, turn on Precise tools and set a smaller bezel inset.</string>
    <!-- The plate's own label is the instruction the ruler screen is built around: the line is where the
         object starts. "start 0" is a coordinate; "start here" is an action. -->
    <string name="start_edge_label_simple">start here</string>
    <string name="start_edge_label_simple_inset_format">start here, %1$s mm from the edge</string>

    <!-- M15 (rule 12): the one switch that decides how much of the app is shown. -->
    <string name="settings_group_mode">Simple mode</string>
    <string name="settings_precise_tools">Precise tools</string>
    <string name="settings_precise_tools_hint">Off keeps the app to the basics: the ruler, the reading and how accurate it is. On adds the technical controls — label size, the bezel inset, pixels per millimetre and the reference sizes.</string>
    <string name="settings_group_accuracy_details">Accuracy details</string>
