    <string name="log_export_scope">Saving a file writes every measurement in the log, not only the ones this search shows.</string>
    <string name="log_export_empty">There is nothing in the log to save yet.</string>
    <!-- Rule 14: every state has a way out on the state itself. -->
    <string name="log_clear_search">Clear search</string>
    <string name="log_close">Close</string>
    <!-- Delete has no undo, so the first tap only arms it and names what is at stake. -->
    <string name="level_empty_state_body">Put the phone on a surface you trust and tap Set this as flat. After that, the angle is measured from that surface.</string>
    <string name="protractor_angle_caption">Angle between edges</string>
    <string name="level_bubble_direction_format">Bubble direction %1$s°</string>

    <string name="pro_column_free">Free</string>

