    <string name="ruler_title">Ruler</string>
    <!-- DESIGN.md §5.4: the caption is separate from the number, so the readout string is the value
         and the unit only. That pair is language-neutral, which is why the German copy is identical
         (see the allowed list in LocalisationTest). -->
    <string name="ruler_readout_format">%1$s %2$s</string>
    <string name="ruler_readout_approx_format">≈ %1$s %2$s (rounded)</string>
    <!-- Rule 13: simple mode says the same thing without the ≈ glyph. -->
    <string name="ruler_readout_approx_simple_format">%1$s %2$s (rounded)</string>
    <string name="ruler_span_caption">Screen span</string>
    <!-- M15 (rule 13): the big number is the length of the screen itself. "Screen span" does not say that. -->
    <string name="ruler_span_caption_simple">This screen measures up to</string>
    <!-- M17: once the user has drawn a span, the same big number is the length of their object. The
         caption has to say which of the two it is, or a reading gets misread. -->
    <string name="ruler_measured_caption">Measured span</string>
    <string name="ruler_measured_caption_simple">You measured</string>
    <string name="ruler_object_slider_label">How long is your object?</string>
    <!-- M17: the one instruction a new install gets, on the screen the action happens on. -->
    <string name="ruler_first_run_instruction">Put your object on the screen with one end on the start line. Touch the ruler where the object ends, or drag along it. The number is how long it is.</string>
    <string name="ruler_first_run_dismiss">Got it</string>
    <!-- TalkBack cannot see the plate, and the plate is where the physical alignment happens. Static on
         purpose: a description that changed with the span would re-announce on every step of the drag. -->
    <string name="ruler_plate_description">Ruler plate. The start line is on the left edge. Put the object on the screen with one end on that line, then touch or drag on the plate to move the measuring line to its other end.</string>
    <string name="ruler_label_size">Label size</string>
    <string name="error_budget_format">Error budget ±%1$s mm per 100 mm</string>
    <!-- Rule 5: provenance and error budget in one line, next to the number they describe. -->
    <string name="provenance_format">%1$s · ±%2$s mm per 100 mm</string>
    <!-- Rule 13: the same fact as simple mode, stated so a reader who has never met the terms can act
         on it. Both modes state it; only the words change. -->
    <string name="ruler_accuracy_estimate_format">Usually within %1$s mm over 10 cm</string>
    <string name="ruler_accuracy_calibrated_format">Accurate to about %1$s mm over 10 cm</string>
