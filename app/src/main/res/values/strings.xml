    <!-- M15 (rule 13): the wording on these screens is plain language. The reading, the accuracy and
         the Pro gate are all still stated; only the words changed. -->
    <string name="level_title">Bubble level</string>
    <string name="level_pro_locked">Level and protractor are part of Pro. The ruler, units, calibration, log and export stay free.</string>
