    <string name="level_clear_zero">Undo flat setting</string>
    <string name="level_flat">Level</string>
    <string name="level_not_flat">Not level</string>
    <!-- With no zero set the reading is the raw tilt from horizontal, so it must not claim to be
         measured against a surface the user never zeroed on (M11R, same rule as finding 3). -->
    <string name="level_direction_format">Downhill direction: %1$s°</string>
    <!-- Rule 5 in words: the sensor reports a status, not an angle, and the number beside it is a
         stated assumption for that status. "typical ±1.0°, assumed" said the same thing in symbols. -->
    <string name="level_accuracy_format">How sure the tilt reading is: %1$s. It is usually within about %2$s°.</string>
    <string name="accuracy_high">high</string>
    <string name="accuracy_medium">medium</string>
    <string name="accuracy_low">low</string>
    <string name="accuracy_unreliable">unreliable</string>
    <string name="accuracy_unknown">not reported</string>
    <string name="level_sensor_missing">This phone has no tilt sensor, so there is nothing to read here. The ruler, log and export still work.</string>

    <string name="protractor_title">Protractor</string>
    <string name="protractor_hint">Lay the phone flat along the first edge, then tap Set first edge. The dashed line shows how the phone is tilted right now.</string>
    <string name="protractor_first_reference">Set first edge</string>
    <string name="protractor_second_reference">Set second edge</string>
    <string name="protractor_clear">Start over</string>
    <string name="protractor_angle_format">Angle: %1$s° (%2$s grad)</string>
    <!-- Rule 12: grads are a second unit for the same angle. Simple mode shows the angle once. -->
    <string name="protractor_angle_simple_format">Angle: %1$s°</string>

    <string name="extend_title">Extend mode</string>
    <string name="extend_pro_locked">Extend mode is part of Pro. The ruler, units, calibration, log and export stay free.</string>
    <string name="extend_hint">Put one end of the object on the start line. Touch or drag on the ruler to move the mark to the object’s other end, then tap Add. If the object is longer than the screen, leave the mark at the screen edge and add that.</string>
    <string name="extend_undo">Undo last mark</string>
    <string name="extend_total_format">Total %1$s %2$s ± %3$s mm</string>
    <!-- Rule 13: the same bound, said as "give or take" instead of the ± symbol. -->
    <string name="extend_total_simple_format">Total: %1$s %2$s, give or take %3$s mm</string>
    <!-- Rule 13: named for the unit, not for the system. "Imperial" is a word about measurement systems;
         the reader wants to know what the second number is in. -->
    <string name="extend_imperial_format">In inches: %1$s</string>
    <string name="extend_estimate_note">Each mark adds a little error, so the total is an estimate, not a guarantee.</string>
    <string name="extend_segment_format">Mark %1$d: %2$s mm</string>

    <string name="pro_title">Pro version</string>
    <string name="pro_features">Pro adds extend mode, the bubble level, the protractor, custom colours and tags, and removes the ad. Everything else — the ruler, all units and fractions, calibration, the log, export and share — stays free.</string>
